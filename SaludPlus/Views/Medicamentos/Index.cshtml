@{
    ViewBag.Title = "Catálogo de Farmacia";
}

<div class="container-fluid mt-4 px-4 mb-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-pills text-success me-2"></i>Gestión de Medicamentos</h5>
            <button class="btn btn-success rounded-pill px-4 shadow-sm fw-bold d-flex align-items-center gap-2" onclick="abrirModal()">
                <i class="fas fa-plus-circle"></i> Nuevo Medicamento
            </button>
        </div>

        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0" id="tablaMedicamentos">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 text-muted small text-uppercase fw-bold">Nombre Comercial</th>
                        <th class="text-muted small text-uppercase fw-bold">Laboratorio</th>
                        <th class="text-muted small text-uppercase fw-bold">Presentación</th>
                        <th class="text-muted small text-uppercase fw-bold text-center">Stock Actual</th>
                        <th class="text-muted small text-uppercase fw-bold">Precio ($)</th>
                        <th class="text-center text-muted small text-uppercase fw-bold pe-4" style="width: 140px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Modal para registro/modificación de Medicamentos *@
<div class="modal fade" id="modalMedicamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white border-0 py-3 px-4">
                <h6 class="modal-title fw-bold" id="tituloModal"><i class="fas fa-capsules me-2"></i>Detalle de Medicamento</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-light-subtle">
                <input type="hidden" id="txtId" value="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">Nombre del Medicamento <span class="text-danger">*</span></label>
                        <input type="text" id="txtNombre" class="form-control border-opacity-25 shadow-sm" placeholder="Ej. Acetaminofén 500mg" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">Laboratorio</label>
                        <input type="text" id="txtLaboratorio" class="form-control border-opacity-25 shadow-sm" placeholder="Ej. MK, Bayer..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">Presentación</label>
                        <select id="cboPresentacion" class="form-select border-opacity-25 shadow-sm">
                            <option value="Tabletas">Tabletas</option>
                            <option value="Cápsulas">Cápsulas</option>
                            <option value="Jarabe">Jarabe</option>
                            <option value="Inyección">Inyección</option>
                            <option value="Crema/Ungüento">Crema/Ungüento</option>
                            <option value="Gotas">Gotas</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold small text-muted">Vía de Administración</label>
                        <select id="cboVia" class="form-select border-opacity-25 shadow-sm">
                            <option value="Oral">Oral</option>
                            <option value="Intravenosa">Intravenosa</option>
                            <option value="Intramuscular">Intramuscular</option>
                            <option value="Tópica">Tópica</option>
                            <option value="Oftálmica">Oftálmica</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-muted">Stock Inicial</label>
                        <input type="number" id="txtStock" class="form-control border-opacity-25 shadow-sm" value="0" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-muted">Stock Mínimo (Alerta)</label>
                        <input type="number" id="txtMinimo" class="form-control border-opacity-25 shadow-sm" value="10" min="0" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold small text-muted">Precio Unitario ($)</label>
                        <input type="number" id="txtPrecio" class="form-control border-opacity-25 shadow-sm" value="0.00" step="0.01" min="0" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white border-0 py-3 px-4">
                <button type="button" class="btn btn-link text-muted text-decoration-none fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm fw-bold" onclick="guardar()">Guardar Registro</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            cargarMedicamentos();
        });

        // 1. CARGAR TABLA GENERAL
        function cargarMedicamentos() {
            $.get('@Url.Action("Listar", "Medicamentos")', function (data) {
                let html = "";
                $.each(data, function (i, item) {

                    let presentacion = item.Presentacion ? item.Presentacion : "No definida";
                    let via = item.ViaAdministracion ? item.ViaAdministracion : "";
                    let esComodin = item.Nombre === "MEDICAMENTO EXTERNO (Solo texto)";

                    let filaClass = esComodin ? "table-primary fw-bold" : "";

                    let stockBadge = esComodin ? `<span class="badge rounded-pill bg-primary px-3 py-1">∞</span>` :
                                     (item.StockActual <= item.StockMinimo ? `<span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1">${item.StockActual}</span>` : `<span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1">${item.StockActual}</span>`);

                    let acciones = "";
                    if (esComodin) {
                        acciones = `<span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 py-2 px-3 fw-bold rounded-pill"><i class="fas fa-lock me-1"></i> Sistema</span>`;
                    } else {
                        acciones = `
                            <div class="d-flex justify-content-center gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-3 border-opacity-25 px-2 shadow-sm d-inline-flex align-items-center" onclick="editarMedicamento(${item.MedicamentoID})" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-3 border-opacity-25 px-2 shadow-sm d-inline-flex align-items-center" onclick="eliminarMedicamento(${item.MedicamentoID})" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        `;
                    }

                    let precioFormateado = parseFloat(item.Precio || 0).toFixed(2);

                    html += `<tr class="${filaClass}">
                                <td class="ps-4 fw-bold text-dark">${item.Nombre}</td>
                                <td class="text-muted small">${item.Laboratorio || '-'}</td>
                                <td><span class="fw-semibold text-secondary">${presentacion}</span> <small class="text-muted">(${via})</small></td>
                                <td class="text-center">${stockBadge}</td>
                                <td class="fw-bold text-success">$${precioFormateado}</td>
                                <td class="pe-4">${acciones}</td>
                             </tr>`;
                });
                $("#tablaMedicamentos tbody").html(html);
            });
        }

        // 2. ABRIR MODAL PARA NUEVO REGISTRO
        function abrirModal() {
            $("#txtId").val("0");
            $("#txtNombre").val("");
            $("#txtLaboratorio").val("");
            $("#cboPresentacion").val("Tabletas");
            $("#cboVia").val("Oral");
            $("#txtStock").val("0");
            $("#txtMinimo").val("10");
            $("#txtPrecio").val("0.00");

            $("#tituloModal").html('<i class="fas fa-capsules me-2"></i>Nuevo Medicamento');
            $("#modalMedicamento").modal('show');
        }

        // 3. ENVIAR DATOS A FORMULARIO DE EDICIÓN
        function editarMedicamento(id) {
            $.get('/Medicamentos/Consultar?id=' + id, function (res) {
                if (res.success) {
                    let m = res.data;

                    $("#txtId").val(m.MedicamentoID);
                    $("#txtNombre").val(m.Nombre);
                    $("#txtLaboratorio").val(m.Laboratorio);
                    $("#txtStock").val(m.StockActual);
                    $("#txtMinimo").val(m.StockMinimo);

                    let precioLimpio = parseFloat(m.Precio || 0).toFixed(2);
                    $("#txtPrecio").val(precioLimpio);

                    if ($(`#cboVia option[value='${m.ViaAdministracion}']`).length === 0 && m.ViaAdministracion) {
                        $("#cboVia").append(`<option value="${m.ViaAdministracion}">${m.ViaAdministracion}</option>`);
                    }
                    $("#cboVia").val(m.ViaAdministracion);

                    if ($(`#cboPresentacion option[value='${m.Presentacion}']`).length === 0 && m.Presentacion) {
                        $("#cboPresentacion").append(`<option value="${m.Presentacion}">${m.Presentacion}</option>`);
                    }
                    $("#cboPresentacion").val(m.Presentacion);

                    $("#tituloModal").html('<i class="fas fa-edit me-2"></i>Editar Medicamento');
                    $("#modalMedicamento").modal('show');
                } else {
                    Swal.fire('Error', res.mensaje, 'error');
                }
            });
        }

        // 4. GUARDAR REGISTRO CON REGLAS DE CONSISTENCIA MÉDICA
        function guardar() {
            let nombre = $("#txtNombre").val().trim();
            let laboratorio = $("#txtLaboratorio").val().trim();
            let presentacion = $("#cboPresentacion").val();
            let via = $("#cboVia").val();

            if (!nombre) {
                Swal.fire('Atención', 'El nombre del medicamento es obligatorio.', 'warning');
                return;
            }

            let combinacionValida = true;
            let mensajeError = "";

            if (presentacion === "Tabletas" || presentacion === "Cápsulas" || presentacion === "Jarabe") {
                if (via !== "Oral") {
                    combinacionValida = false;
                    mensajeError = `La presentación <strong>${presentacion}</strong> exige estrictamente la vía de administración <strong>Oral</strong>.`;
                }
            }
            else if (presentacion === "Inyección") {
                if (via !== "Intravenosa" && via !== "Intramuscular") {
                    combinacionValida = false;
                    mensajeError = `Las <strong>Inyecciones</strong> solo se permiten por vía <strong>Intramuscular</strong> o <strong>Intravenosa</strong>.`;
                }
            }
            else if (presentacion === "Crema/Ungüento") {
                if (via !== "Tópica") {
                    combinacionValida = false;
                    mensajeError = `La presentación en <strong>Crema/Ungüento</strong> requiere la vía <strong>Tópica</strong>.`;
                }
            }
            else if (presentacion === "Gotas") {
                if (via !== "Oftálmica" && via !== "Oral") {
                    combinacionValida = false;
                    mensajeError = `Las <strong>Gotas</strong> deben corresponder a la vía <strong>Oftálmica</strong> u <strong>Oral</strong>.`;
                }
            }

            if (!combinacionValida) {
                Swal.fire({
                    icon: 'error',
                    title: 'Inconsistencia en el Registro',
                    html: `<div class="text-start small">${mensajeError}<br><br>Por favor, ajusta los campos para que sigan una relación médica lógica.</div>`,
                    confirmButtonColor: '#20c997'
                });
                return;
            }

            let obj = {
                MedicamentoID: $("#txtId").val(),
                Nombre: nombre,
                Laboratorio: laboratorio,
                Presentacion: presentacion,
                ViaAdministracion: via,
                StockActual: $("#txtStock").val(),
                StockMinimo: $("#txtMinimo").val(),
                Precio: $("#txtPrecio").val()
            };

            $.post('/Medicamentos/Guardar', obj, function (res) {
                if (res.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '¡Guardado!',
                        text: 'El medicamento se guardó correctamente.',
                        showConfirmButton: false,
                        timer: 1500
                    });
                    $("#modalMedicamento").modal('hide');
                    cargarMedicamentos();
                } else {
                    Swal.fire('Error del Servidor', res.mensaje, 'error');
                }
            });
        }

        // 5. ELIMINAR REGISTRO CON SWEETALERT2
        function eliminarMedicamento(id) {
            Swal.fire({
                title: '¿Eliminar Medicamento?',
                text: "Esta acción ocultará el medicamento del catálogo sin alterar el historial médico.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.post('/Medicamentos/Eliminar?id=' + id, function (res) {
                        if (res.success) {
                            Swal.fire('¡Eliminado!', 'El medicamento ha sido borrado del catálogo.', 'success');
                            cargarMedicamentos();
                        } else {
                            Swal.fire('No se puede eliminar', res.mensaje, 'error');
                        }
                    });
                }
            });
        }
    </script>
}