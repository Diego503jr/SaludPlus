@{
    ViewBag.Title = "Calendario Médico";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-dark"><i class="fas fa-calendar-alt text-primary me-2"></i> Mi Agenda Visual</h4>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div id='calendarioMedico'></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/&#64;fullcalendar/core@6.1.11/locales/es.global.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendarioMedico');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth', // Vista de mes por defecto
                locale: 'es', // Idioma español
                themeSystem: 'bootstrap5',

                // Opciones de la barra superior
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay' // Botones para ver por Mes, Semana o Día
                },

                events: '@Url.Action("ObtenerEventosCalendario", "Citas")',

                // --- ACTUALIZADO CON SWEETALERT2 ---
                eventClick: function(info) {
                    if (info.jsEvent) {
                        info.jsEvent.preventDefault();
                    }

                    let paciente = info.event.title;
                    let fechaInicio = info.event.start;

                    // Formateamos la fecha de forma legible (DD/MM/YYYY)
                    let fechaFormateada = ("0" + fechaInicio.getDate()).slice(-2) + "/" +
                                          ("0" + (fechaInicio.getMonth() + 1)).slice(-2) + "/" +
                                          fechaInicio.getFullYear();

                    // Formateamos la hora en formato 24h legible (HH:MM)
                    let horaFormateada = ("0" + fechaInicio.getHours()).slice(-2) + ":" +
                                         ("0" + fechaInicio.getMinutes()).slice(-2);

                    // Capturamos el motivo del extendedProps por si tu JSON lo incluye en el backend
                    let motivo = (info.event.extendedProps && info.event.extendedProps.motivo)
                                 ? info.event.extendedProps.motivo
                                 : "Cita de Control / Seguimiento Clínico";

                    // Lanzamos la tarjeta de información moderna de SweetAlert2
                    Swal.fire({
                        title: '<span class="text-primary fw-bold fs-4">Detalle de la Cita</span>',
                        html: `
                            <div class="text-start p-2 small" style="font-size: 14px;">
                                <p class="mb-2"><i class="fas fa-user text-muted me-2" style="width: 20px;"></i><strong>Paciente:</strong> <span class="text-dark fw-bold">${paciente}</span></p>
                                <p class="mb-2"><i class="fas fa-calendar-day text-muted me-2" style="width: 20px;"></i><strong>Fecha:</strong> ${fechaFormateada}</p>
                                <p class="mb-2"><i class="fas fa-clock text-muted me-2" style="width: 20px;"></i><strong>Hora programada:</strong> ${horaFormateada} hrs</p>
                                <div class="border-top pt-2 mt-2">
                                    <p class="mb-1 text-muted"><i class="fas fa-notes-medical me-2" style="width: 20px;"></i><strong>Motivo de consulta:</strong></p>
                                    <span class="text-dark d-block bg-light p-2 rounded border style="font-style: italic;">"${motivo}"</span>
                                </div>
                            </div>
                        `,
                        icon: 'info',
                        confirmButtonColor: '#0d6efd',
                        confirmButtonText: '<i class="fas fa-check me-1"></i> Entendido',
                        customClass: {
                            popup: 'rounded-4 border-0 shadow-sm'
                        }
                    });
                }
            });

            // Renderizamos el calendario en pantalla
            calendar.render();
        });
    </script>
}