@using SaludPlus.Models
@{
    var u = (Usuarios)Session["User"];
}

<nav class="navbar navbar-expand navbar-light navbar-custom sticky-top">
    <div class="container-fluid">
        <button class="btn btn-light border d-lg-none me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar">
            <i class="fas fa-bars"></i>
        </button>

        <h5 class="mb-0 fw-bold text-secondary d-none d-sm-block">@ViewBag.Title</h5>

        <div class="ms-auto dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <div class="text-end me-3 d-none d-sm-block">
                    @if (u != null)
                    {
                        <p class="mb-0 fw-bold small">@u.Nombres @u.Apellidos</p>
                        <p class="mb-0 text-muted" style="font-size: 11px;">@(u.Roles?.Nombre ?? "Sin Rol")</p>
                    }
                    else
                    {
                        <p class="mb-0 fw-bold small">Invitado</p>
                    }
                </div>
                <i class="bi bi-person-circle fs-3 text-primary"></i>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                @if (u.Roles?.Nombre != "Administrador")
                {
                    <li><a class="dropdown-item py-2" href="@Url.Action("Index","Perfil")"><i class="bi bi-person me-2"></i>Perfil</a></li>
                }
                <li><hr class="dropdown-divider"></li>
                <li>
                    <button class="dropdown-item py-2 text-danger fw-bold" onclick="CerrarSesion()">
                        <i class="bi bi-box-arrow-right me-2"></i>Cerrar Sesión
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title text-primary fw-bold">Salud Plus</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        @Html.Partial("_Sidebar")
    </div>
</div>

<script>
    function CerrarSesion() {
        Swal.fire({
            title: '¿Cerrar sesión?',
            text: 'Se cerrará tu sesión actual.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="bi bi-box-arrow-right me-1"></i> Sí, salir',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/api/auth/logout',
                    type: 'POST',
                    contentType: 'application/json',
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: '¡Hasta luego!',
                                text: 'Tu sesión se cerró correctamente.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => {
                                window.location.href = '/Login/Login';
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Error',
                            text: 'No se pudo cerrar la sesión. Intenta de nuevo.',
                            icon: 'error',
                            confirmButtonColor: '#dc3545'
                        });
                    }
                });
            }
        }); 
    }
</script>