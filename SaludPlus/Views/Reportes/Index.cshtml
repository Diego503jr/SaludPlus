@using SaludPlus.Models
@{
    ViewBag.Title = "Módulo de Reportes";

    // Recuperamos la sesión del usuario para validar los accesos en el cliente
    var usuario = (Usuarios)Session["User"];
    var nombreRol = usuario?.Roles?.Nombre ?? "";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4 text-primary"><i class="fas fa-file-pdf"></i> Panel de Reportes Consolidados</h2>
            <p class="text-muted">Seleccione el reporte que desea generar. Toda la información se consulta en tiempo real desde el servidor en la nube.</p>
            <hr />
        </div>
    </div>

    <div class="row">

        @* ======================================================= *@
        @* 1. HISTORIAL CLÍNICO (Filtrado por DUI - Médicos y Admin)*@
        @* ======================================================= *@
        @if (nombreRol == "Administrador" || nombreRol == "Medico")
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-success"><i class="fas fa-user-injured"></i> Historial Clínico</h5>
                        <p class="card-text text-muted small">Exporta el expediente completo de un paciente específico ingresando su número de DUI.</p>

                        @* Cambiado a FormMethod.Post para enviar cadenas complejas de forma segura *@
                        @using (Html.BeginForm("DescargarHistorial", "Reportes", FormMethod.Post, new { target = "_blank" }))
                        {
                            <div class="form-group mb-3">
                                <label class="form-label small fw-bold">Número de DUI del Paciente:</label>
                                @* Cambiado a tipo text, con máscara de patrón nativo salvadoreño *@
                                <input type="text"
                                       name="dui"
                                       class="form-control form-control-sm"
                                       required
                                       placeholder="00000000-0"
                                       pattern="[0-9]{8}-[0-9]{1}"
                                       title="El formato debe ser de 8 dígitos, un guion y un dígito (Ej: 01234567-8)" />
                            </div>
                            <button type="submit" class="btn btn-success btn-sm w-100">
                                <i class="fas fa-download"></i> Generar PDF
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        @* ========================================================== *@
        @* 2. CITAS POR PERIODO (Visible para Recepcionistas y Admin) *@
        @* ========================================================== *@
        @if (nombreRol == "Administrador" || nombreRol == "Recepcionista")
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-info"><i class="fas fa-calendar-check"></i> Citas por Periodo</h5>
                        <p class="card-text text-muted small">Consulta el consolidado de citas con estado 'Completada' o 'Cancelada' dentro de un rango de fechas determinado.</p>

                        @using (Html.BeginForm("DescargarCitas", "Reportes", FormMethod.Get, new { target = "_blank" }))
                        {
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label cs-small small fw-bold">Desde:</label>
                                    <input type="date" name="fechaInicio" class="form-control form-control-sm" required />
                                </div>
                                <div class="col-6">
                                    <label class="form-label cs-small small fw-bold">Hasta:</label>
                                    <input type="date" name="fechaFin" class="form-control form-control-sm" required />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-info btn-sm text-white w-100">
                                <i class="fas fa-download"></i> Generar PDF
                            </button>
                        }
                    </div>
                </div>
            </div>
        }

        @* ======================================================= *@
        @* 3. INVENTARIO DE MEDICAMENTOS (Solo visible para Admin)  *@
        @* ======================================================= *@
        @if (nombreRol == "Administrador")
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-warning"><i class="fas fa-pills"></i> Inventario de Medicamentos</h5>
                            <p class="card-text text-muted small">Reporte general de existencias en farmacia. Prioriza automáticamente en la parte superior los fármacos con stock crítico o bajo el mínimo de reorden.</p>
                        </div>
                        <div class="mt-4">
                            <a href="@Url.Action("DescargarInventario", "Reportes")" target="_blank" class="btn btn-warning btn-sm text-white w-100">
                                <i class="fas fa-download"></i> Descargar Reporte Completo
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>