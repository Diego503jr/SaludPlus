@model SaludPlus.Models.Usuarios
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - SaludPlus</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="@Url.Content("~/Content/styles/Login.css")" rel="stylesheet" />
</head>
<body>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="card login-card p-4">
                    <div class="card-body">
                        <h2 class="text-center mb-4 text-primary">Salud Plus</h2>
                        <p class="text-center text-muted">Ingresa tus credenciales</p>

                        <hr />

                        <div class="mb-3">
                            <label class="form-label">Correo Electrónico</label>
                            @Html.TextBox("Email", null, new { @id = "txtEmail", @class = "form-control", placeholder = "nombre@correo.com", required = "required" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Contraseña</label>
                            @Html.Password("PasswordHash", null, new { @id = "txtPassword", @class = "form-control", placeholder = "********", required = "required" })
                        </div>

                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary btn-login" onclick="IniciarSesion()">
                                Iniciar Sesión
                            </button>
                        </div>

                        <div id="msgError" class="alert alert-danger mt-3 d-none" role="alert">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-white border-top mt-auto" style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000;">
        <div class="bg-light">
            <div class="container-fluid px-4 py-3">
                <div class="row align-items-center g-3">
                    <div class="col-md-8 col-lg-9">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3 d-none d-sm-flex">
                                <i class="bi bi-phone text-primary fs-3"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold text-primary">
                                    <i class="bi bi-android2 me-1 d-sm-none"></i>
                                    ¡Lleva Salud Plus en tu móvil!
                                </h6>
                                <p class="mb-0 text-muted small">
                                    Descarga nuestra aplicación para Android y accede desde cualquier lugar.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-3 text-md-end">
                        <a href="@Url.Content("~/Content/downloads/SaludPlus.apk")"
                           download="SaludPlus.apk"
                           class="btn btn-primary fw-bold"
                           onclick="MostrarDescarga()">
                            <i class="bi bi-download me-2"></i>Descargar APK
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Copyright  -->
        <div class="container-fluid px-4 py-2 border-top">
            <div class="text-center text-muted small">
                Copyright &copy; Salud Plus @DateTime.Now.Year
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
    function IniciarSesion() {
        $("#msgError").addClass("d-none").text("");

        var usuarioModel = {
            Email: $("#txtEmail").val(),
            PasswordHash: $("#txtPassword").val()
        };

        if (!usuarioModel.Email || !usuarioModel.PasswordHash) {
            $("#msgError").removeClass("d-none").text("Por favor, llena todos los campos.");
            return;
        }

        $.ajax({
            url: '/api/auth/login',
            type: 'POST',
            data: JSON.stringify(usuarioModel),
            contentType: 'application/json',
            success: function (response) {
                if (response.success) {
                    window.location.href = '@Url.Action("Index", "Home")';
                } else {
                    $("#msgError").removeClass("d-none").text(response.message);
                }
            },
            error: function (xhr) {
                if (xhr.status === 400) {
                    $("#msgError").removeClass("d-none").text("Email y contraseña son requeridos.");
                } else if (xhr.status === 401) {
                    $("#msgError").removeClass("d-none").text("Datos incorrectos.");
                } else {
                    $("#msgError").removeClass("d-none").text("Error de conexión con el servidor.");
                }
            }
        });
    }

    $("#txtPassword").keypress(function (e) {
        if (e.which == 13) {
            IniciarSesion();
        }
    });

    var apkUrl = '@Url.Content("~/Content/downloads/SaludPlus.apk")';

    function MostrarDescarga() {
        Swal.fire({
            title: '¿Descargar aplicación?',
            text: 'Se descargará la aplicación SaludPlus para Android.',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#0d6efd',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="bi bi-download me-1"></i> Sí, descargar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = apkUrl;
            }
        });
    }
    </script>

</body>
</html>